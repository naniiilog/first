# ── 무료로 쓰기 ─────────────────────────────────────────
# 이 키 하나만 있으면 AI 10종을 모두 무료로 쓸 수 있어요.
# (제미나이 무료 사용량으로 각 AI 스타일을 연기해요. 하루 사용량 제한이 있어요.)
# 발급: https://aistudio.google.com/apikey  (결제 정보 없이 발급)
GEMINI_API_KEY=

# ── 유료(선택) ──────────────────────────────────────────
# 넣은 AI만 '따라하기'가 아니라 진짜 그 AI가 답해요. 사용료가 나가요.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# META_API_KEY=

# 따라하기에 쓰는 무료 모델 (선택)
# FREE_MODEL=gemini-2.5-flash

# 남이 내 서버를 못 쓰게 하는 비밀 문자열 (배포할 때 강력 추천). 앱에도 같은 값을 넣어요.
# APP_TOKEN=

# PORT=8787
# RATE_PER_MINUTE=20
